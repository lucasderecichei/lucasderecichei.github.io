---
import { portfolioData } from '../data/portfolio';
---

<header class="sticky top-0 z-40 border-b border-slate-800/70 bg-[#0b111e]/85 backdrop-blur-md">
  <nav
    aria-label="Primary navigation"
    class="mx-auto flex max-w-5xl items-center justify-center gap-6 px-5 py-3.5 sm:gap-9"
  >
    {
      portfolioData.navLinks.map((link) => (
        <a
          href={link.href}
          class="text-xs font-medium tracking-wide text-slate-400 transition-colors hover:text-slate-50 sm:text-[13px]"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
