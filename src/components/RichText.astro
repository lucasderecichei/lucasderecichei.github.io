---
import type { TextSegment, ThemeTone } from '../data/portfolio';

interface Props {
  segments: TextSegment[];
}

const { segments } = Astro.props;

const accentClass: Record<ThemeTone | 'bold', string> = {
  bold: 'font-semibold text-slate-100',
  teal: 'font-medium text-teal-400',
  burgundy: 'font-medium text-rose-400',
  slate: 'font-medium text-slate-200 underline decoration-slate-500/60 underline-offset-4',
};
---

{
  segments.map((seg) =>
    seg.href ? (
      <a
        href={seg.href}
        target={seg.href.startsWith('http') ? '_blank' : undefined}
        rel={seg.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="text-slate-200 underline decoration-slate-500/70 underline-offset-4 transition-colors hover:text-teal-300 hover:decoration-teal-400"
      >
        {seg.text}
      </a>
    ) : seg.accent ? (
      <span class={accentClass[seg.accent]}>{seg.text}</span>
    ) : (
      seg.text
    ),
  )
}
