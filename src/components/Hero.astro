---
import { portfolioData, type ThemeTone } from '../data/portfolio';
import { withBase } from '../utils/paths';
import RichText from './RichText.astro';

const { hero } = portfolioData;

const pillStyles: Record<ThemeTone, string> = {
  teal: 'border-teal-500/35 bg-teal-950/50 text-teal-300',
  burgundy: 'border-rose-500/35 bg-rose-950/45 text-rose-300',
  slate: 'border-slate-600/60 bg-slate-800/60 text-slate-300',
};

const hasBioContent =
  hero.name.trim().length > 0 ||
  hero.bioIntro.length > 0 ||
  hero.researchPrompt.trim().length > 0 ||
  hero.bioBody.length > 0 ||
  hero.bioClosing.trim().length > 0 ||
  hero.pills.length > 0;
---

<section id="about" class="scroll-mt-20 pt-10 sm:pt-14">
  <div class="flex flex-col items-start gap-8 md:flex-row md:gap-11">
    <!-- Left column: rounded portrait frame + optional social icons -->
    <div class="flex w-full shrink-0 flex-col items-center md:w-56 lg:w-60">
      <div class="w-48 overflow-hidden rounded-xl border border-slate-800 bg-[#111a2c] shadow-xl shadow-black/30 md:w-full">
        {
          hero.portrait ? (
            <img
              src={withBase(hero.portrait)}
              alt={hero.portraitAlt}
              width="400"
              height="460"
              class="aspect-[6/7] w-full object-cover"
            />
          ) : (
            <div class="flex aspect-[6/7] w-full items-center justify-center bg-[#111a2c]">
              <svg
                class="h-12 w-12 text-slate-700"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            </div>
          )
        }
      </div>

      {
        hero.socials.length > 0 && (
          <div class="mt-5 flex items-center justify-center gap-4">
            {hero.socials.map((item) => {
              const href = item.href.startsWith('/') ? withBase(item.href) : item.href;
              const isExternal = href.startsWith('http');
              return (
                <a
                  href={href}
                  title={item.label}
                  aria-label={item.label}
                  target={isExternal || item.icon === 'cv' ? '_blank' : undefined}
                  rel={isExternal ? 'noopener noreferrer' : undefined}
                  class="rounded-lg p-1.5 text-slate-400 transition-colors hover:bg-slate-800/70 hover:text-teal-300"
                >
                  {item.icon === 'email' && (
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="4" width="20" height="16" rx="2" />
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                  )}
                  {item.icon === 'github' && (
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
                    </svg>
                  )}
                  {item.icon === 'scholar' && (
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                      <path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5" />
                    </svg>
                  )}
                  {item.icon === 'linkedin' && (
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z" />
                    </svg>
                  )}
                  {item.icon === 'cv' && (
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <path d="M14 2v6h6" />
                      <path d="M16 13H8" />
                      <path d="M16 17H8" />
                      <path d="M10 9H8" />
                    </svg>
                  )}
                </a>
              );
            })}
          </div>
        )
      }
    </div>

    <!-- Right column: Bio & research focus, or clean empty placeholder -->
    <div class="w-full flex-1 space-y-4">
      {
        hasBioContent ? (
          <>
            {hero.name && (
              <h1 class="text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl">
                {hero.name}
              </h1>
            )}

            {hero.bioIntro.length > 0 && (
              <p class="text-sm leading-relaxed text-slate-300 sm:text-[15px]">
                <RichText segments={hero.bioIntro} />
              </p>
            )}

            {hero.researchPrompt && (
              <div
                class="my-2 flex items-center gap-3 rounded-full border border-slate-200 bg-slate-100 px-4 py-2.5 text-slate-700 shadow-md shadow-black/25"
                role="note"
                aria-label="Primary research question"
              >
                <svg
                  class="h-4 w-4 shrink-0 text-teal-600"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="8" />
                  <path d="m21 21-4.3-4.3" />
                </svg>
                <p class="font-mono text-xs leading-snug text-slate-700 sm:text-[13px]">
                  {hero.researchPrompt}
                </p>
              </div>
            )}

            {hero.bioBody.length > 0 && (
              <p class="text-sm leading-relaxed text-slate-300 sm:text-[15px]">
                <RichText segments={hero.bioBody} />
              </p>
            )}

            {hero.bioClosing && (
              <p class="text-sm leading-relaxed text-slate-400">
                {hero.bioClosing}
              </p>
            )}

            {hero.pills.length > 0 && (
              <div class="flex flex-wrap gap-2.5 pt-2">
                {hero.pills.map((pill) => (
                  <span
                    class={`inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium ${pillStyles[pill.tone]}`}
                  >
                    {pill.label}
                  </span>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="rounded-xl border border-dashed border-slate-800 bg-[#111a2c]/40 p-6 sm:p-8">
            <div class="mb-4 h-7 w-48 rounded-md bg-slate-800/60"></div>
            <div class="mb-4 flex items-center gap-3 rounded-full border border-slate-700/60 bg-slate-900/70 px-4 py-2.5">
              <svg
                class="h-4 w-4 shrink-0 text-slate-500"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.3-4.3" />
              </svg>
              <span class="font-mono text-xs text-slate-500">Coming soon</span>
            </div>
            <p class="text-sm text-slate-500">
              Portfolio content will be added here soon.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
